{
  "name": "SAML",
  "scopeName": "source.saml",
  "patterns": [
    { "name": "comment.line.double-slash.saml", "match": "//.*$" },
    { "name": "string.quoted.double.saml", "begin": "\"", "end": "\"", "patterns": [
      { "name": "constant.character.escape.saml", "match": "\\\\." }
    ] },
    { "name": "string.quoted.single.saml", "begin": "'", "end": "'", "patterns": [
      { "name": "constant.character.escape.saml", "match": "\\\\." }
    ] },
    { "name": "variable.other.property.saml", "match": "\\b[a-z][A-Za-z0-9_]*(?=\\s*[:{])" },
    { "name": "keyword.declaration.saml", "match": "\\b(?:boundary|concept|rule)\\b" },
    { "name": "constant.language.saml", "match": "\\b(?:false|successful|true)\\b" },
    { "name": "entity.name.type.saml", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" },
    { "name": "punctuation.separator.saml", "match": "[:,;]" },
    { "name": "punctuation.definition.saml", "match": "[{}\\[\\]()]" }
  ]
}
