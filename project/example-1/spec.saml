
// maybe instead of declaration, this should be a keyword
// because it is a logical boundry declaration.
boundry Scope {

}
// maybe instead of declaration, this should be a keyword,
// because it is a technical boundry declaration.
boundry Application {

}
// Boundry allows to use access operators: Public/Private
boundry Entity {}


boundry Layer {}


concept Interface {}

concept Technology {}

concept Environment {}

concept ApplicationType {
  environment {
    type: Environment
  }
  technology {
    type Technology
  }
}

concept ApplicationCapability {}
concept Application {
  type {
    type: ApplicationType
  }
  capability {
    type: ApplicationCapability
  }
}

concept Event {

}


concept Entity {
  capabilities {
    
  }
  relationship {

  }
}

// maybe rule should be a keyword, instead of just part of a spec model
// rules are crosslayer concern
concept Rule {

}

concept Action {
  initiator {
    type: Entity
  }
}

concept Data {

}

concept State {
  from {

  }
}


concept WorkflowStage {
  state {
    type State
  }
}

concept Workflow {
  initiator { 
    type:Action
  }
  stage {
    type:WorkflowStage
  }
}

