


scope Identity entity User {

}



workflowStage CommonStage {

}

workflowStage SpecialStage {

}



scope Article action ArticlePublication {
  initiator:User
}



scope Article {

  entity Author {

  }

  entity Article {

  }

  rule ArticleLettersNumberIsHigherThan { }

  workflowStage Evaluation extends CommonStage SpecialStage {
    context: [Author, Article];

    state: Initial
    state: Successful
      from: Initial
      when: ArticleLettersNumberIsHigherThan is respected
      then: emit event Successful;
    state: Failed
      from Initial
      when: ArticleLettersNumberIsHigherThan is not respected
      then: emit event Failed;
  }


  workflowStage Publication extends CommonStage {

  }


  workflow ArticlePublication {
    initiator: ArticlePublication from: ArticlePublicationQueue
    stage: Evaluation
    stage: Publication after: Evaluation when: Evaluation is successful
  }

  queue ArticlePublicationQueue uses RabbitMQ {

  }
}

technical queue RabbitMQ {

}












